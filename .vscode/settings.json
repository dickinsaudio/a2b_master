{
    // C/C++ navigation comes from the firmware build (make firmware writes build/compile_commands.json)
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.default.cStandard": "c11",
    // The Makefile drives CMake; stop CMake Tools from configuring firmware/ or extern/ on its own
    "cmake.configureOnOpen": false,
    "cmake.ignoreCMakeListsMissing": true,
    "files.watcherExclude": { "**/build/**": true, "**/extern/**": true },
    "search.exclude": { "build/**": true, "extern/**": true },
    "go.toolsEnvVars": { "GOFLAGS": "-mod=mod" }
}
